# -------- Local default (SQLite) --------
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me
USE_DB=1

# --------Google Analytics --------
GA_ID=

# -------- Server Configuration --------
# HOST=127.0.0.1  # Default: localhost only
# HOST=0.0.0.0    # For production: accessible from all interfaces
# PORT=5001       # Default port

# -------- MySQL template (fill when ready) --------
# If you run MySQL locally on default port 3306:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>?charset=utf8mb4

# If you SSH-tunnel to the server and forward to local port 3307:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3307/<DB_NAME>?charset=utf8mb4
